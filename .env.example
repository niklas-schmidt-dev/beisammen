# Public Expo runtime config.
# Everything prefixed with EXPO_PUBLIC_ is bundled into the client and must be
# treated as public information.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_SCHEME=beisammen
EXPO_PUBLIC_DEFAULT_INSTANCE_ID=beisammen-cloud
EXPO_PUBLIC_DEFAULT_INSTANCE_NAME=Beisammen Cloud
# Public base URL for your backend HTTP actions.
EXPO_PUBLIC_DEFAULT_INSTANCE_URL=https://your-deployment.eu-west-1.convex.site
# Convex client URL used by ConvexReactClient.
EXPO_PUBLIC_DEFAULT_CONVEX_URL=https://your-deployment.eu-west-1.convex.cloud
EXPO_PUBLIC_DEFAULT_DEPLOYMENT_KIND=cloud
# Clerk publishable key from the Clerk dashboard (API keys page).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# RevenueCat public SDK keys. Development builds use the synthetic Test Store
# key on both platforms; preview/production builds require the matching store
# key. Optional for self-hosted deployments, which have no billing.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Public EAS project ID required for Expo push token registration on real devices.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_LOG_LEVEL=trace
# General Translation (gt-react-native). Source language is de, translated to en.
# GT_PROJECT_ID + GT_API_KEY are used by the `gt` CLI (`pnpm translate` in
# apps/mobile, and the EAS eas-build-post-install hook). Committed files in
# apps/mobile/src/_gt/ are the fallback when the keys are absent.
GT_PROJECT_ID=
GT_API_KEY=
# Optional: enables on-demand translation while developing (dev API key, not the
# production one). Get both from the https://generaltranslation.com dashboard.
EXPO_PUBLIC_GT_PROJECT_ID=
EXPO_PUBLIC_GT_DEV_API_KEY=

# Backend runtime configuration
# Public base URL for the landing page waitlist form.
PUBLIC_INSTANCE_BASE_URL=https://your-deployment.eu-west-1.convex.site
INSTANCE_BASE_URL=https://your-deployment.eu-west-1.convex.site
# Custom URL scheme used when backend HTTP actions redirect back into the app.
PUBLIC_APP_SCHEME=beisammen
# Website origin that hosts the /connect hand-off page for invite links
# (https links are required so chat apps render them as tappable). Defaults
# to https://beisammen.app; self-hosters keep the default unless they run
# their own website with the app association files.
PUBLIC_INVITE_LINK_BASE_URL=https://beisammen.app
# Public instance discovery manifest values served from
# /.well-known/beisammen-instance.json. These are safe to expose to clients.
PUBLIC_INSTANCE_ID=beisammen-cloud
PUBLIC_INSTANCE_NAME=Beisammen Cloud
PUBLIC_CONVEX_URL=https://your-deployment.eu-west-1.convex.cloud
# Clerk publishable key served to clients through instance discovery.
PUBLIC_AUTH_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_DEPLOYMENT_KIND=cloud
# Legacy override. Prefer PUBLIC_DEPLOYMENT_KIND; set this only for older envs.
PUBLIC_SELF_HOSTED=false
# Optional JSON array exposed in instance discovery and the mobile billing card.
# Cloud billing is paid-only; do not advertise a free storage-generating plan.
# Plan ids must match the RevenueCat entitlement identifiers.
PUBLIC_BILLING_PLANS='[{"id":"cloud_plus","name":"Plus","monthlyPriceLabel":"$5.99/month","yearlyPriceLabel":"$49.99/year"},{"id":"cloud_max","name":"Max","monthlyPriceLabel":"$11.99/month","yearlyPriceLabel":"$99.99/year"}]'
# Minimum mobile app version allowed to connect through instance discovery.
# Custom instance links and `pnpm smoke:beta -- <instance-url> --app-version=...` enforce this.
PUBLIC_MINIMUM_APP_VERSION=0.1.0

# RevenueCat webhook shared secret for cloud deployments. Generate with
# `openssl rand -base64 32`, set the same value as the Authorization header of
# the RevenueCat webhook integration, and set it in Convex with
# `npx convex env set REVENUECAT_WEBHOOK_AUTH=<secret>`.
# Self-hosted deployments ignore this and have no payments or
# app-enforced usage limits.
REVENUECAT_WEBHOOK_AUTH=

# Resend (retention warning emails via the @convex-dev/resend component).
# Emails stay in test mode (only resend.dev addresses) until
# RESEND_TEST_MODE=false is set alongside a production API key.
RESEND_API_KEY=
RESEND_TEST_MODE=true
RETENTION_EMAIL_FROM="Beisammen <no-reply@beisammen.app>"

# All official and self-hosted deployments use Clerk for auth.
# The issuer domain comes from the Clerk JWT template named "convex"
# (e.g. https://your-app.clerk.accounts.dev). Set it in Convex with
# `npx convex env set CLERK_JWT_ISSUER_DOMAIN=<issuer-domain>`.
CLERK_JWT_ISSUER_DOMAIN=

# Storage and service secrets
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_BASE_PATH=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EXPO_TOKEN=
# Optional for store/development builds that use Google Maps through
# react-native-maps. Expo Go can render maps without these keys, but Android
# release builds require a restricted Google Maps API key.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Server-side notification delivery stays skipped until this is configured.
# APNs/FCM credentials remain managed outside git through EAS/provider setup.
EXPO_PUSH_ACCESS_TOKEN=

# Intentionally omitted from version control by default:
# - EAS owner / account metadata
# - EAS project IDs
# - APNs / FCM credentials
# - provider production secrets
