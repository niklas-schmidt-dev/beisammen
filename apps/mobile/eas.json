{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "uploadSourceMaps": true
    },
    "store-sandbox": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "uploadSourceMaps": true
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "uploadSourceMaps": true
    }
  },
  "submit": {
    "store-sandbox": {
      "android": {
        "applicationId": "app.beisammen.app",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6762514050"
      }
    },
    "production": {
      "android": {
        "applicationId": "app.beisammen.app",
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6762514050"
      }
    }
  }
}
